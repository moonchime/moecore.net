{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moecore-net",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "moecore.net",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
